# Copy to .env and fill locally. Root .env is Git-ignored. Never put secrets in frontend NEXT_PUBLIC variables.
APP_ENV=local
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
APP_TIME_ZONE=Asia/Kolkata
CURRENCY_CODE=INR

# SUPABASE POSTGRESQL: one relational database project, service-owned schemas.
SUPABASE_PROJECT_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JDBC_URL=jdbc:postgresql://YOUR_DB_HOST:5432/postgres?sslmode=require
DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=30000
# Use service-specific DB roles where Supabase grants permit it. Dev fallback may use one restricted dev role.
IDENTITY_DB_USERNAME=REPLACE_ME
IDENTITY_DB_PASSWORD=REPLACE_ME
CATALOG_DB_USERNAME=REPLACE_ME
CATALOG_DB_PASSWORD=REPLACE_ME
INVENTORY_DB_USERNAME=REPLACE_ME
INVENTORY_DB_PASSWORD=REPLACE_ME
COMMERCE_DB_USERNAME=REPLACE_ME
COMMERCE_DB_PASSWORD=REPLACE_ME
PAYMENT_DB_USERNAME=REPLACE_ME
PAYMENT_DB_PASSWORD=REPLACE_ME
FULFILLMENT_DB_USERNAME=REPLACE_ME
FULFILLMENT_DB_PASSWORD=REPLACE_ME

# CLOUDINARY MEDIA STORAGE (not a second relational database)
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME
CLOUDINARY_SECURE=true

# Authentication
JWT_ISSUER=dz-fashion
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14
OTP_TTL_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Email sender credentials (configure provider and verified domain locally)
MAIL_HOST=REPLACE_ME
MAIL_PORT=587
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME
MAIL_FROM_NAME=D & Z Fashion
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_STARTTLS=true

# Service ports and internal addresses
API_GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=8081
CATALOG_SERVICE_PORT=8082
INVENTORY_SERVICE_PORT=8083
COMMERCE_SERVICE_PORT=8084
PAYMENT_SERVICE_PORT=8085
FULFILLMENT_SERVICE_PORT=8086
IDENTITY_SERVICE_URL=http://localhost:8081
CATALOG_SERVICE_URL=http://localhost:8082
INVENTORY_SERVICE_URL=http://localhost:8083
COMMERCE_SERVICE_URL=http://localhost:8084
PAYMENT_SERVICE_URL=http://localhost:8085
FULFILLMENT_SERVICE_URL=http://localhost:8086

# Simulated payment only. No real payment gateway or card collection in phase one.
PAYMENT_MODE=SIMULATED
SIMULATED_PAYMENT_DEFAULT_RESULT=SUCCESS
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_DZ=INFO

# Customer authentication is owned by Spring Identity Service; no Supabase Auth key is required.
